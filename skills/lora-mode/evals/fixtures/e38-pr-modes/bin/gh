#!/usr/bin/env python3
import json
import pathlib
import re
import sys

root = pathlib.Path(__file__).resolve().parents[1]
state_path = root / "state.json"
state = json.loads(state_path.read_text())
args = sys.argv[1:]
with (root / "calls.jsonl").open("a") as calls:
    calls.write(json.dumps(args) + "\n")

repo = state["repository"]
number = str(state["number"])


def output(data, jq=None):
    if jq:
        expressions = [expression.strip() for expression in jq.split("|")]
        values = [data]
        expands = False
        try:
            for expression in expressions:
                if not expression.startswith("."):
                    fail("fixture supports simple jq paths and array iteration", 2)
                expands = expands or "[]" in expression
                next_values = []
                for value in values:
                    current = [value]
                    index = 1
                    while index < len(expression):
                        char = expression[index]
                        if char == ".":
                            index += 1
                            continue
                        if char == "[":
                            end = expression.find("]", index)
                            if end == -1:
                                fail("fixture supports simple jq paths and array iteration", 2)
                            token = expression[index + 1 : end]
                            selected = []
                            for item in current:
                                if not isinstance(item, list):
                                    fail("fixture jq array operation requires an array", 2)
                                if token:
                                    selected.append(item[int(token)])
                                else:
                                    selected.extend(item)
                            current = selected
                            index = end + 1
                            continue
                        start = index
                        while index < len(expression) and (expression[index].isalnum() or expression[index] == "_"):
                            index += 1
                        if start == index:
                            fail("fixture supports simple jq paths and array iteration", 2)
                        key = expression[start:index]
                        current = [item[key] for item in current]
                    next_values.extend(current)
                values = next_values
        except (IndexError, KeyError, TypeError, ValueError):
            fail("fixture jq path did not match the returned data", 2)

        if expands or len(values) > 1:
            for value in values:
                if isinstance(value, (dict, list)):
                    print(json.dumps(value))
                elif isinstance(value, bool):
                    print("true" if value else "false")
                elif value is None:
                    print("null")
                else:
                    print(value)
        elif values:
            value = values[0]
            if isinstance(value, (dict, list)):
                print(json.dumps(value))
            elif isinstance(value, bool):
                print("true" if value else "false")
            elif value is None:
                print("null")
            else:
                print(value)
    else:
        print(json.dumps(data, indent=2))


def write_state():
    state_path.write_text(json.dumps(state, indent=2) + "\n")


def pr_view_data():
    latest_reviews = {}
    all_reviews = []
    for review in state["reviews"]:
        user = review.get("user") or {}
        login = user.get("login") or review.get("login")
        item = {
            "author": {"login": login} if login else None,
            "state": review.get("state", "").upper(),
            "submittedAt": review.get("submitted_at"),
            "commit": {"oid": review.get("commit_id")} if review.get("commit_id") else None,
            "body": review.get("body", ""),
        }
        all_reviews.append(item)
        if login:
            latest_reviews[login] = item
    return {
        "id": state["node_id"],
        "number": state["number"],
        "title": state["title"],
        "state": "MERGED" if state["merged"] else state["state"].upper(),
        "isDraft": state["draft"],
        "baseRefName": state["base"]["ref"],
        "headRefName": state["head"]["ref"],
        "headRefOid": state["head"]["sha"],
        "mergeable": "MERGEABLE" if state["mergeable"] else "CONFLICTING",
        "mergeStateStatus": state["mergeable_state"].upper(),
        "reviewDecision": state["reviewDecision"],
        "reviews": all_reviews,
        "latestReviews": list(latest_reviews.values()),
        "statusCheckRollup": status_check_rollup(),
        "autoMergeRequest": {
            "enabledAt": state.get("auto_merge_enabled_at", "2026-11-02T00:00:00Z"),
            "mergeMethod": state.get("auto_merge_method"),
        } if state.get("auto_merge_enabled") else None,
        "mergedAt": state.get("merged_at"),
        "url": f"https://github.com/{repo}/pull/{number}",
    }


def rest_pr_data():
    return {
        "url": f"https://api.github.com/repos/{repo}/pulls/{number}",
        "html_url": f"https://github.com/{repo}/pull/{number}",
        "id": state["rest_id"],
        "node_id": state["node_id"],
        "number": state["number"],
        "title": state["title"],
        "state": "closed" if state["merged"] else state["state"],
        "draft": state["draft"],
        "merged": state["merged"],
        "merged_at": state.get("merged_at"),
        "merge_commit_sha": state.get("merge_commit_sha"),
        "base": state["base"],
        "head": state["head"],
        "mergeable": state["mergeable"],
        "mergeable_state": state["mergeable_state"],
        "auto_merge": {
            "enabled_by": {"login": "fixture-user"},
            "merge_method": state.get("auto_merge_method"),
        } if state.get("auto_merge_enabled") else None,
    }


def counted_approvals():
    latest_by_reviewer = {}
    for review in state["reviews"]:
        user = review.get("user") or {}
        login = user.get("login") or review.get("login")
        review_state = review.get("state", "").upper()
        # Comment-only reviews are informational and do not replace a submitted decision.
        if login and review_state in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            latest_by_reviewer[login] = review
    # The fixture models lora-mode's stricter merge gate: required approval
    # must match the current head even when GitHub keeps stale approvals.
    return sum(
        1
        for review in latest_by_reviewer.values()
        if review.get("state", "").upper() == "APPROVED"
        and review.get("commit_id") == state["head"]["sha"]
    )


def status_check_passed(check):
    return (
        check.get("status") == "completed"
        and check.get("conclusion") in ("success", "skipped", "neutral")
    )


def merge_gate_ready():
    rules = state["repository_rules"]
    check_runs = state["required_check_runs"]
    checks_by_name = {check.get("name"): check for check in check_runs}
    check_runs_passed = all(status_check_passed(check) for check in check_runs)
    required_checks_passed = all(
        context in checks_by_name
        and status_check_passed(checks_by_name[context])
        for context in rules.get("required_status_checks", [])
    )
    checks_passed = check_runs_passed and required_checks_passed
    risk_review = state.get("risk_review") or {}
    risk_review_ready = state["risk"] != "High" or (
        risk_review.get("status") == "completed"
        and not risk_review.get("blocking_findings")
    )
    review_decision = (state.get("reviewDecision") or "").upper()
    required_reviews = rules["required_review_count"]
    reviews_ready = (
        review_decision != "CHANGES_REQUESTED"
        and (
            required_reviews == 0
            or (review_decision == "APPROVED" and counted_approvals() >= required_reviews)
        )
    )
    return (
        state["state"].lower() == "open"
        and not state["draft"]
        and state["mergeable"]
        and state["mergeable_state"].lower() == "clean"
        and not state["blocking_findings"]
        and checks_passed
        and risk_review_ready
        and reviews_ready
    )


def merge_squash():
    state["merged"] = True
    state["merge_method"] = "squash"
    state["merged_at"] = "2026-11-02T00:00:00Z"
    state["merge_commit_sha"] = "fixture-merge-sha"
    state["auto_merge_enabled"] = False
    state["auto_merge_method"] = None
    state["in_merge_queue"] = False
    write_state()


def jq_arg():
    for flag in ("--jq", "-q"):
        if flag in args:
            return args[args.index(flag) + 1]
    return None


def form_values():
    values = {}
    for index, arg in enumerate(args[:-1]):
        if arg in ("-f", "-F", "--field", "--raw-field"):
            key, value = args[index + 1].split("=", 1)
            values[key] = value
    return values


def status_check_rollup():
    return [
        {
            "__typename": "CheckRun",
            "completedAt": run.get("completed_at"),
            "conclusion": (run.get("conclusion") or "").upper() or None,
            "detailsUrl": run.get("html_url", "https://github.com/example/checks"),
            "name": run.get("name"),
            "startedAt": run.get("started_at"),
            "status": run.get("status", "queued").upper(),
            "workflowName": run.get("workflow", "CI"),
        }
        for run in state["required_check_runs"]
    ]


def pr_check_rows():
    bucket_for = {
        "success": "pass",
        "neutral": "pass",
        "failure": "fail",
        "timed_out": "fail",
        "action_required": "fail",
        "startup_failure": "fail",
        "cancelled": "cancel",
        "skipped": "skipping",
    }
    rows = [
        {
            "bucket": bucket_for.get(run.get("conclusion"), "pending"),
            "completedAt": run.get("completed_at"),
            "description": run.get("name"),
            "event": run.get("event", "push"),
            "link": run.get("html_url", "https://github.com/example/checks"),
            "name": run.get("name"),
            "startedAt": run.get("started_at"),
            "state": (run.get("conclusion") or run.get("status", "pending")).upper(),
            "workflow": run.get("workflow", "CI"),
        }
        for run in state["required_check_runs"]
    ]
    present = {run.get("name") for run in state["required_check_runs"]}
    for context in state["repository_rules"].get("required_status_checks", []):
        if context not in present:
            rows.append({
                "bucket": "pending",
                "completedAt": None,
                "description": context,
                "event": "push",
                "link": "https://github.com/example/checks",
                "name": context,
                "startedAt": None,
                "state": "PENDING",
                "workflow": "CI",
            })
    return rows


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


if args[:2] == ["pr", "view"] and len(args) >= 3 and args[2] == number:
    data = pr_view_data()
    if "--json" in args:
        fields = args[args.index("--json") + 1].split(",")
        unknown = [field for field in fields if field not in data]
        if unknown:
            fail(f"unsupported --json field: {', '.join(unknown)}", 2)
        data = {field: data[field] for field in fields}
    output(data, jq_arg())
elif args[:2] == ["pr", "checks"] and len(args) >= 3 and args[2] == number:
    checks = pr_check_rows()
    data = checks
    if "--json" in args:
        fields = args[args.index("--json") + 1].split(",")
        allowed = {"bucket", "completedAt", "description", "event", "link", "name", "startedAt", "state", "workflow"}
        unknown = [field for field in fields if field not in allowed]
        if unknown:
            fail(f"unsupported --json field: {', '.join(unknown)}", 2)
        data = [{field: check[field] for field in fields} for check in data]
        output(data, jq_arg())
    else:
        for check in data:
            print(f"{check['bucket']}: {check['name']} ({check['state']})")
    if any(check["bucket"] == "pending" for check in checks):
        sys.exit(8)
    if any(check["bucket"] == "fail" for check in checks):
        sys.exit(1)
elif args[:2] == ["pr", "merge"] and len(args) >= 3 and args[2] == number:
    if "--admin" in args:
        fail("admin bypass is disabled in this fixture", 2)
    if "--disable-auto" in args:
        if state.get("in_merge_queue"):
            print(f"PR #{number} is already in the merge queue")
        else:
            state["auto_merge_enabled"] = False
            state["auto_merge_method"] = None
            write_state()
            print(f"Disabled auto-merge for PR #{number}")
    elif "--squash" not in args:
        fail("this fixture requires --squash", 2)
    elif state["merged"]:
        fail("pull request is already merged")
    elif state.get("in_merge_queue"):
        fail("pull request is already in the merge queue", 2)
    elif "--auto" in args and not merge_gate_ready():
        state["auto_merge_enabled"] = True
        state["auto_merge_method"] = "squash"
        state["auto_merge_enabled_at"] = "2026-11-02T00:00:00Z"
        write_state()
        print(f"Automatic squash merge enabled for PR #{number}")
    elif state["repository_rules"]["merge_queue"]:
        if not merge_gate_ready():
            fail("required merge conditions are not satisfied")
        state["in_merge_queue"] = True
        write_state()
        print(f"Added PR #{number} to the merge queue")
    elif merge_gate_ready():
        merge_squash()
        print(f"Squashed and merged PR #{number}")
    else:
        fail("required merge conditions are not satisfied")
elif args[:2] == ["api", "graphql"]:
    forms = form_values()
    query = forms.get("query", "")
    if "dequeuePullRequest" in query:
        inline_id = re.search(
            r'dequeuePullRequest\s*\(\s*input\s*:\s*\{\s*id\s*:\s*"([^"]+)"',
            query,
        )
        requested_id = forms.get("id") or (inline_id.group(1) if inline_id else None)
        if requested_id != state["node_id"]:
            fail("dequeuePullRequest requires the pull request GraphQL id", 2)
        if not state.get("in_merge_queue"):
            fail("pull request is not in the merge queue")
        state["in_merge_queue"] = False
        write_state()
        output({"data": {"dequeuePullRequest": {"clientMutationId": forms.get("clientMutationId")}}}, jq_arg())
    elif "isInMergeQueue" in query and re.search(r"pullrequest", query, re.IGNORECASE):
        pull_request = {
            "id": state["node_id"],
            "isInMergeQueue": state.get("in_merge_queue", False),
            "mergeQueueEntry": {"id": "MQE_fixture"} if state.get("in_merge_queue") else None,
        }
        node_query = re.search(r"\bnode\s*\(", query, re.IGNORECASE)
        if node_query:
            inline_id = re.search(r'node\s*\(\s*id\s*:\s*"([^"]+)"', query, re.IGNORECASE)
            requested_id = forms.get("id") or (inline_id.group(1) if inline_id else None)
            if requested_id != state["node_id"]:
                fail("isInMergeQueue requires the pull request GraphQL id", 2)
            data = {"data": {"node": pull_request}}
        else:
            data = {"data": {"repository": {"pullRequest": pull_request}}}
        output(data, jq_arg())
    else:
        fail("unsupported fixture GraphQL operation", 2)
elif args[:1] == ["api"] and len(args) >= 2:
    endpoint = args[1].strip("/")
    if endpoint == f"repos/{repo}":
        data = {
            "name": repo.rsplit("/", 1)[-1],
            "full_name": repo,
            "default_branch": "main",
            "allow_squash_merge": state["repository_rules"]["allow_squash_merge"],
            "delete_branch_on_merge": state["repository_rules"]["delete_branch_on_merge"],
        }
    elif endpoint == f"repos/{repo}/pulls/{number}":
        data = rest_pr_data()
    elif endpoint == f"repos/{repo}/pulls/{number}/reviews":
        data = state["reviews"]
    elif endpoint == f"repos/{repo}/commits/{state['head']['sha']}/check-runs":
        data = {"total_count": len(state["required_check_runs"]), "check_runs": state["required_check_runs"]}
    elif endpoint == f"repos/{repo}/branches/{state['base']['ref']}/protection":
        if not state["repository_rules"]["branch_protection"]:
            fail("HTTP 404: branch protection is not enabled")
        review_count = state["repository_rules"]["required_review_count"]
        required_reviews = None if review_count == 0 else {"required_approving_review_count": review_count}
        data = {
            "required_status_checks": (
                {"strict": False, "contexts": state["repository_rules"].get("required_status_checks", [])}
                if state["repository_rules"].get("required_status_checks")
                else None
            ),
            "required_pull_request_reviews": (
                {
                    **required_reviews,
                    "dismiss_stale_reviews": state["repository_rules"].get("dismiss_stale_reviews", False),
                }
                if required_reviews
                else None
            ),
        }
    else:
        fail(f"unsupported mock API endpoint: {endpoint}", 2)
    output(data, jq_arg())
else:
    fail(f"unsupported mock gh command: {' '.join(args)}", 2)
